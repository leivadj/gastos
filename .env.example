# Copia este archivo a .env.local y completa con los datos de tu proyecto
# de Supabase (Project Settings -> API).
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-publica

# Solo para app/api/sugerencias-correo (automatización de "Sugerencias" desde
# el correo del banco, ver migration_29_sugerencias_correo.sql) — NUNCA con
# prefijo NEXT_PUBLIC_, son server-only y no deben llegar al navegador.
# SUPABASE_SERVICE_ROLE_KEY: Project Settings -> API -> service_role (secreta).
# BOT_OWNER_ID: uuid de la cuenta dueña (correr en el SQL Editor:
#   select id from auth.users where email = 'tu-correo@gmail.com';).
# BOT_SHARED_SECRET: cualquier cadena larga al azar que también uses en la
#   tarea programada que le pega a este endpoint.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-secreta
BOT_OWNER_ID=uuid-de-tu-cuenta
BOT_SHARED_SECRET=elegi-un-secreto-largo-al-azar
